# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: lo usa /api/focus/current para responder a los Atajos de iOS sin sesión.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (solo servidor, nunca en el cliente)
GEMINI_API_KEY=
# Opcional: modelos. Por defecto se usan los alias "latest" de Google.
GEMINI_MODEL_FAST=gemini-flash-latest
GEMINI_MODEL_PRO=gemini-pro-latest
GEMINI_MODEL_LITE=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# URL pública de la app (OAuth de Google, enlaces de Telegram y webhooks)
APP_URL=https://tu-dominio.com

# Panel de vida: OAuth de Google (Calendar, Gmail y Tasks). Redirect URI: $APP_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra los tokens de Google en la base de datos: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Cron del resumen matinal y de la revisión nocturna (Vercel manda Authorization: Bearer $CRON_SECRET)
CRON_SECRET=

# Bot de Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
